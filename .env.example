MAILOPS_BASE_URL=https://admin.mailops.example.com
MAILOPS_API_TOKEN=
EMAIL_DOMAIN=example.com
DEFAULT_PASSWORD=
# 注册时若 GitHub 报 "email already associated"，自动换新邮箱重试的最大次数（默认 5）
EMAIL_COLLISION_RETRY=5
# 去重时额外读取的历史记录文件（默认 data/results.jsonl + data/sessions.jsonl）
# SESSIONS_FILE=data/sessions.jsonl
# OAuth 批处理优先读取重筛后的可用池；显式指定时覆盖默认选择。
# SESSION_STORE_FILE=data/sessions.rescreened.usable.jsonl

HEADLESS=false
CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Use PROXY for one proxy, or PROXY_LIST/REGISTER_PROXY_LIST for comma-separated pools.
PROXY=
PROXY_LIST=
REGISTER_PROXY_LIST=

TOKEN_NAME=claude
TOKEN_UNLIMITED_QUOTA=true
TOKEN_EXPIRED_TIME=-1
TOKEN_REMAIN_QUOTA=0

# 只对 cun.ai 生效：普通用户不能创建无限额度 token，默认每次随机 $21-$50
CUNAI_TOKEN_UNLIMITED_QUOTA=false
CUNAI_TOKEN_REMAIN_QUOTA=random
CUNAI_TOKEN_QUOTA_MIN_USD=21
CUNAI_TOKEN_QUOTA_MAX_USD=50

CAPTCHA_SOLVER=
CAPTCHA_API_KEY=
CAPTCHA_TIMEOUT_MS=120000
CAPTCHA_POLL_INTERVAL_MS=3000

# api.nsnzd.com admin import
API_NSNZD_COM_ADMIN_KEY=

# oauth:site:batch 分组选择持久化文件（默认 data/oauth-site-batch-groups.json）
# OAUTH_SITE_GROUP_CONFIG_FILE=data/oauth-site-batch-groups.json
# OAUTH_SITE_BATCH_TOTAL=20
# OAUTH_SITE_BATCH_DELAY_MIN_MS=30
# OAUTH_SITE_BATCH_DELAY_MAX_MS=60

# run.sh local sing-box bridge
HYSTERIA2_PASSWORD=
